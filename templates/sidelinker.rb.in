# frozen_string_literal: true

# This template is NOT an active Homebrew cask.
# Generate Casks/sidelinker.rb from a published, notarized SideLinker Mac DMG:
# python3 scripts/render-cask.py --version VERSION --url RELEASE_DMG_URL --dmg /path/to/release.dmg
cask "sidelinker" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "__URL__"
  name "SideLinker"
  desc "Use iPad or iPhone as a display for your Mac"
  homepage "https://github.com/wberry9813/SideLinker"

  app "SideLinker Mac.app"

  # Intentionally no zap stanza or service/launchd manipulation.
  # App-managed login items, permissions, sessions, and user data are outside the cask lifecycle.
end
